+void
+cmove(Client *what, Client *where, int dir)
+{
+    Client *pwhat, *pwhere, *nwhat;
+
+    if ( !what || !where || what == where
+         || (!dir && what->next  == where )
+         || ( dir && where->next == what  ) )
+        return;
+
+    pwhat = cprev(what);
+    nwhat = where;
+    if (!dir)
+        pwhere = cprev(where);
+
+    if (pwhat)
+        pwhat->next = what->next;
+    else
+        selmon->clients = what->next;
+
+    if (dir) {
+        nwhat = where->next;
+        where->next = what;
+    } else {
+        if (pwhere)
+            pwhere->next = what;
+        else
+            selmon->clients = what;
+    }
+
+    what->next = nwhat;
+}
