+Client *
+cprev(Client *c)
+{
+    Client *x, *y;
+
+    if (!c)
+        return NULL;
+
+    for ( x = NULL, y = selmon->clients
+        ; y && y != c
+        ; x = y, y = y->next
+        );
+    return y ? x : y;
+}
+
+Client *
+cprevtiled(Client *c)
+{
+    Client *x, *y;
+
+    if (!c)
+        return NULL;
+
+    for ( x = NULL, y = nexttiled(selmon->clients)
+        ; y && y != c
+        ; x = y, y = nexttiled(y->next)
+        );
+    return y ? x : y;
+}
