+          && rlmap[i].from != rlmap[i].to )
+            break;
+
+    if (i == LENGTH(rlmap))
+        return;
+
+    for (j = 0; j < LENGTH(layouts); ++j)
+        if (rlmap[i].to == layouts[j].arrange)
+            break;
+
+    if (j == LENGTH(rlmap))
+        return;
