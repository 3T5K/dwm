+void
+swapmon(const Arg *arg)
+{
+    Monitor *arr[2], *m1, *m2, *i;
+    int x;
+
+    if (!arg || !mons->next)
+        return;
+
+    m1 = selmon;
+
+    for ( m2 = NULL, i = mons
+        ; i && i != m1
+        ; m2 = i, i = i->next );
+
+    if ((arg->i > 0 && m1->next) || !m2)
+        m2 = m1->next;
+
+    if (selmon->sel)
+        unfocus(selmon->sel, 1);
+
+    unsigned int tmp_ts[2] = { m1->tagset[0], m1->tagset[1] };
+    m1->tagset[0] = m2->tagset[0];
+    m1->tagset[1] = m2->tagset[1];
+    m2->tagset[0] = tmp_ts[0];
+    m2->tagset[1] = tmp_ts[1];
+
+    const Layout *tmp_lt[2] = { m1->lt[0], m1->lt[1] };
+    m1->lt[0] = m2->lt[0];
+    m1->lt[1] = m2->lt[1];
+    m2->lt[0] = tmp_lt[0];
+    m2->lt[1] = tmp_lt[1];
+
+    Client *c;
+    for (c = m1->clients; c; c = c->next)
+        c->mon = m2;
+    for (c = m2->clients; c; c = c->next)
+        c->mon = m1;
+
+#define SWAP_(type, member) \
+    type tmp_##member = m1->member; \
+    m1->member = m2->member; \
+    m2->member = tmp_##member;
+
+    SWAP_(Client *, clients);
+    SWAP_(Client *, stack);
+    SWAP_(Pertag *, pertag);
+    SWAP_(Client *, sel);
+    SWAP_(int, showbar);
+    SWAP_(int, topbar);
+    SWAP_(float, mfact);
+    SWAP_(int, nmaster);
+    SWAP_(unsigned int, sellt);
+    SWAP_(unsigned int, seltags);
+
+#undef SWAP_
+
+    focus(NULL);
+
+    arr[0] = m1; arr[1] = m2;
+    for (x = 0; x < 2; ++x) {
+        updatebarpos(arr[x]);
+        XMoveResizeWindow(
+            dpy,
+            arr[x]->barwin,
+            arr[x]->wx,
+            arr[x]->by,
+            arr[x]->ww,
+            bh
+        );
+        arrange(arr[x]);
+    }
+}
